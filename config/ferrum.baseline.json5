// Ferrum baseline config for the engine 2026.9.7  (Telegram + Docker sandbox + plugins/ferrum)
//
// Installed by `ferrum setup` (scripts/wsl/40-configure.sh) to ~/.openclaw/openclaw.json (chmod 600).
// Secrets are NOT in this file: ${VAR} placeholders are filled from ~/.openclaw/.env
// (chmod 600, outside the agent workspace; sandbox exec does not inherit the gateway env).
// Every key below was checked against the engine's config schema for this exact version
// (tests/contract/baseline-config.test.mjs).
{
  // ---- Gateway: this machine only, token for UI/API ----------------------------------
  gateway: {
    mode: "local",
    bind: "loopback",
    port: 18789,
    auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" },
  },
  discovery: { mdns: { mode: "off" } },

  // ---- Model: user's OpenAI-compatible endpoint --------------------------------------
  // Model id and API key are supplied by the owner via ~/.openclaw/.env
  // (FERRUM_MODEL_ID, FERRUM_MODEL_API_KEY).
  models: {
    mode: "merge",
    providers: {
      custom: {
        baseUrl: "http://localhost:20128/v1",
        api: "openai-completions",
        apiKey: "${FERRUM_MODEL_API_KEY}",
        models: [
          {
            id: "${FERRUM_MODEL_ID}",
            name: "${FERRUM_MODEL_ID}",
            reasoning: false,
            input: ["text"],
            contextWindow: 128000,
            maxTokens: 8192,
          },
        ],
      },
    },
  },

  agents: {
    defaults: {
      model: "custom/${FERRUM_MODEL_ID}",
      workspace: "~/ferrum/workspace",
      // The engine's default is 48 h. A per-turn wall-clock cap (stage 2 adds step/token caps).
      timeoutSeconds: 600,
      sandbox: {
        mode: "all", // every session, including cron and sub-agents
        backend: "docker",
        scope: "session", // one container per session
        workspaceAccess: "rw", // ONLY the agent workspace is mounted (at /workspace)
        docker: {
          image: "ferrum-sandbox:bookworm-slim", // scripts/wsl/30-build-sandbox-image.sh
          // Run as the host user's uid:gid so the bind-mounted workspace is writable; the id
          // has no passwd entry in the image and no extra privileges. Set by 40-configure.sh.
          user: "${FERRUM_SANDBOX_UID:-1000}:${FERRUM_SANDBOX_GID:-1000}",
          network: "none", // no egress at all
          readOnlyRoot: true,
          capDrop: ["ALL"],
          tmpfs: ["/tmp", "/var/tmp", "/run"],
          memory: "1g",
          pidsLimit: 256,
          cpus: 2,
          // No `binds`, no `env`, no `dns`, no docker.sock. Do not add secrets here:
          // docker.env is visible through `docker inspect`.
        },
      },
    },
  },

  // ---- Tools: stock tools never touch the host; the only host route is plugins/ferrum ---
  tools: {
    exec: { host: "sandbox", timeoutSeconds: 120 },
    elevated: { enabled: false },
    fs: { workspaceOnly: true },
    loopDetection: { enabled: true },
    // Plugin tools are hidden behind Tool Search by default; local_* must be called directly.
    toolSearch: false,
    // Sessions are sandboxed (sandbox.mode "all"), and the sandbox tool policy would drop plugin
    // tools. local_* are registered by plugins/ferrum only while a session is in local mode
    // (and eligible); this just lets them through the sandbox policy when they are.
    sandbox: { tools: { alsoAllow: ["local_*"] } },
  },
  acp: { enabled: false }, // ACP runtime would run on the HOST, outside the sandbox

  // ---- Chat commands that touch the host/config are off ------------------------------
  commands: {
    bash: false,
    config: false,
    mcp: false,
    plugins: false,
    debug: false,
    restart: false,
    ownerAllowFrom: ["telegram:${FERRUM_TELEGRAM_USER_ID}"],
  },

  // ---- Telegram: owner only ----------------------------------------------------------
  channels: {
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_BOT_TOKEN}",
      dmPolicy: "allowlist",
      allowFrom: ["${FERRUM_TELEGRAM_USER_ID}"],
      groupPolicy: "disabled",
      capabilities: { inlineButtons: "dm" }, // approval buttons
      // Approval prompts (also plugin: approvals from plugins/ferrum) go to the owner's DM.
      execApprovals: { enabled: true, approvers: ["${FERRUM_TELEGRAM_USER_ID}"], target: "dm" },
      configWrites: false,
    },
  },

  // ---- Plugins: allowlist instead of the 41 bundled ones enabled by default ----------
  // Stage 1 needs only the Telegram channel (stage 2: plus ferrum). Others (browser, canvas, file-transfer,
  // linux-node, cua-computer, xai, ...) add host-reaching or remote tools and stay off
  // until a stage needs them and its tests exist.
  // Stage 2 adds our own plugin (plugins/ferrum: /mode, local_* tools, policy, approvals, audit).
  // ${FERRUM_REPO} is written to ~/.openclaw/.env by `ferrum setup`.
  plugins: {
    allow: ["telegram", "ferrum"],
    load: { paths: ["${FERRUM_REPO}/plugins/ferrum"] },
    entries: {
      ferrum: {
        enabled: true,
        // Everything else has defaults (plugins/ferrum/openclaw.plugin.json): D:\Ferrum is mounted at
        // /mnt/d/Ferrum, 10 min idle, 120 s exec timeout, audit in ~/.ferrum/audit.
        config: { localRoot: "D:\\Ferrum" },
      },
    },
  },

  // ---- Cron and scheduled jobs stay off until stage 6 --------------------------------
  cron: { enabled: false },
}
